# Скопіюйте цей файл у .env.local для локального запуску.
# На Vercel ті самі змінні задаються у Settings → Environment Variables.
# .env.local у git не потрапляє (див. .gitignore) — реальні значення сюди не вписуйте.

# ── Обов'язкові ────────────────────────────────────────────────────────────

# ID таблиці — з URL між /d/ і /edit
SPREADSHEET_ID=

# Дані сервісного акаунта Google (поля client_email і private_key з JSON-ключа).
# Ключ вставляйте в лапках, разом із символами \n — код сам перетворить їх
# на переноси рядків.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=""

# Пароль для входу на сайт. Якщо порожній — локально захист вимкнено,
# а на Vercel не пускає нікого: зникла змінна не має відкривати таблицю.
APP_PASSWORD=

# Секрет для підпису сесій — будь-який довгий випадковий рядок.
# Згенерувати: openssl rand -hex 32
# Без нього вхід вимкнений: підписати сесію нічим, а підписувати чимось
# відомим означало б видати вхід, який підробляється з вихідників.
SESSION_SECRET=

# ── Фото на складі (необов'язкові) ─────────────────────────────────────────

# ID папки на Google Диску, куди складати фото.
# Можна вставити і чистий ID, і ціле посилання на папку.
# Без цієї змінної завантаження фото вимкнене, а поле з посиланням працює.
GOOGLE_DRIVE_FOLDER_ID=

# OAuth-клієнт для доступу до Диска від вашого імені. Працює і зі звичайним
# @gmail.com. Створюється в Google Cloud Console → Credentials → OAuth client ID
# (Web application), redirect URI: https://ВАШ-ДОМЕН/api/oauth/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Видається один раз: відкрийте /api/oauth/start на сайті й підтвердіть доступ.
# Там же покажуть готовий GOOGLE_DRIVE_FOLDER_ID.
GOOGLE_OAUTH_REFRESH_TOKEN=

# Лише для Google Workspace із делегуванням. На звичайному @gmail.com не працює —
# Google відповість invalid_grant: account not found. Деталі — у README.
GOOGLE_IMPERSONATE_USER=

# ── Здоровʼя (необов'язкові) ───────────────────────────────────────────────

# Особистий розділ /me — доступний лише цьому позивному.
# Назви змінних лишились із часів, коли розділ звався «Здоровʼя»:
# міняти їх означало б заводити все наново у Vercel.
HEALTH_OWNER=Fantomas
# Окрема таблиця для даних здоровʼя. Без неї листи лягають у спільну таблицю,
# і їх побачить кожен, хто має доступ до самого файлу Google Таблиць.
HEALTH_SPREADSHEET_ID=

# Ключ для «Команд» на iPhone: з ним вони можуть надсилати кроки й спалені
# калорії на /api/health-in. Поки змінної немає, маршрут вимкнено.
HEALTH_INGEST_TOKEN=

# ── Головний (необов'язковий) ──────────────────────────────────────────────

# Позивний того, кому дозволено переписувати дати етапів доставки.
# Адміністраторів може бути кілька, але відкотити посилку на етап назад
# може лише ця людина.
#
# Навмисно змінна оточення, а не роль у листі «Люди»: сенс «тільки я»
# зникає, щойно право можна видати собі самому, маючи доступ до таблиці.
# Якщо не задано, береться HEALTH_OWNER.
OWNER=

# ── Пункт збору (необов'язковий) ───────────────────────────────────────────

# Ключ для сторінки /zbir — того, хто збирає посилки.
# Він працює без пароля до сайту: посилання вигляду
#   https://ВАШ-ДОМЕН/zbir?k=КЛЮЧ
# відкриває обмежену форму: створити картку й виправити її, доки посилка
# не доїхала. Усе інше веде черговий.
# Поки змінної немає або ключ коротший за 16 символів, /api/pack віддає 404,
# а сторінка показує «Пункт збору вимкнено».
# Згенерувати: openssl rand -base64 30 | tr -d '/+=' | cut -c1-40
PACK_TOKEN=

# ── Що задавати не треба ───────────────────────────────────────────────────

# VERCEL_ENV, VERCEL_GIT_COMMIT_SHA, VERCEL_GIT_COMMIT_REF,
# VERCEL_GIT_COMMIT_MESSAGE і NEXT_PUBLIC_VERCEL_GIT_COMMIT_SHA підставляє
# сам Vercel під час збірки — код їх читає, але вписувати їх нікуди не треба.

# Важливо про Vercel: змінні «запікаються» у збірку. Якщо додали нову змінну,
# самого лише Promote старої збірки замало — потрібна нова збірка
# (Redeploy або новий коміт), інакше код її не побачить.
